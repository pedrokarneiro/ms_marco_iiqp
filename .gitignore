collection.tsv
collection.tar.gz

# ------------------------------------------------------------
# INDEXING OUTPUT
# ------------------------------------------------------------
# Final index
index/
indexes/
data/index/
data/indexes/

# Posting files
*.postings
*.posting
*.postings.bin
*.posting.bin

# Lexicon / dictionary files
*.lexicon
*.dict
*.dictionary

# Document tables
*.doctable
*.doc_table
*.documents

# Collection statistics
*.stats

# Binary index files
*.bin

# Memory-mapped index files
*.mmap

