# metadata, but generated index files should not be committed.
*.pkl
*.pickle

# ------------------------------------------------------------
# LOCAL CONFIGURATION / SECRETS
# ------------------------------------------------------------
.env
.env.*
!.env.example

# Local machine configuration
config.local.*
config_local.*
local_config.*

