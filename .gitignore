runs/
data/runs/
index_runs/
intermediate_runs/
*.run
*.runs
*.run.*
*.tmp
*.temp

# Temporary merge files
*.merge
*.merge.*
merge_tmp/
tmp_runs/

# ------------------------------------------------------------
# DEVELOPMENT DATA
# ------------------------------------------------------------
# Local development subsets
data/dev/
data/development/
data/toy/
data/test/

# Keep documentation files in data directories if needed
!data/**/README.md

